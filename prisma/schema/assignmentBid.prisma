model AssignmentBid {
  id       String     @id @default(uuid())

  assignmentId   String
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  
  expertId String
  expert   Expert     @relation(fields: [expertId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  proposedAmount    Float
  estimatedDelivery DateTime
  coverNote         String
  
  status            BidStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, expertId])
  @@map("assignmentBids")
}
