model Payment {
  id            String         @id @default(uuid())

  assignmentId        String         @unique
  assignment          Assignment     @relation(fields: [assignmentId], references: [id])

  transactionId String?         @unique //bkash tx id
  amount        Float
  status        PaymentStatus  @default(INITIATED)
  paymentGateway        PaymentGateway  @default(BKASH)

  // bkash
  merchantInvoiceNumber String?  @unique // assignment id
  bkashPaymentId        String? @unique
  bkashTrxId            String? @unique
  payerReference        String? //users email or phoneNo
  paidAt                String?
  gatewayResponse       Json?

  // others payments

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}
